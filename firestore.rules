rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && (
        request.auth.uid in [
          // Put your owner UID(s) here.
          "5vM0JDJ6qiRFsJkZ7d24eNE8lNs1"
        ] ||
        request.auth.token.email in [
          // Put your owner email(s) here (lowercase).
          "paulbenson108@gmail.com"
        ]
      );
    }

    match /runSubmissions/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /vodSubmissions/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /commentatorData/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /siteContent/{docId} {
      allow read: if true;
      // Homepage changes can only be published by the configured site owner.
      allow create, update: if isOwner();
      allow delete: if false;
    }
  }
}
